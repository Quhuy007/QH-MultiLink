<Window x:Class="QH.MultiLinkShortener.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:QH.MultiLinkShortener.App" Title="QH Multi-Link">
 <Grid x:Name="Root" RequestedTheme="Light" Background="{ThemeResource CanvasBrush}" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged">
  <Grid.Resources>
   <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource BrandColor}"/>
   <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource BrandColor}"/>
   <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource BrandColor}"/>
   <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource BrandColor}"/>
   <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource BrandColor}"/>
   <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource BrandColor}"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{ThemeResource BrandColor}"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{ThemeResource BrandColor}"/>
   <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource BrandColor}"/>
   <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource OnBrandColor}"/>
   <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource OnBrandColor}"/>
   <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource OnBrandColor}"/>

   <DataTemplate x:Key="ResultTemplate" x:DataType="local:ResultRow">
    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12" HorizontalAlignment="Stretch">
     <Grid ColumnSpacing="8" RowSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="3"><TextBlock Text="{x:Bind ProviderName}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}"/><TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/></StackPanel>
      <TextBlock Grid.Column="1" Text="{x:Bind Time}" FontSize="11" MaxWidth="105" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Link, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="14" Foreground="{ThemeResource BrandBrush}"/>
      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource SecondaryText}"/>
      <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
       <Button Content="Sao chép" Style="{StaticResource ActionButton}" IsEnabled="{x:Bind CanUse, Mode=OneWay}" Tag="{Binding}" Click="Copy_Click"/>
       <Button Content="Mở link" Style="{StaticResource ActionButton}" IsEnabled="{x:Bind CanUse, Mode=OneWay}" Tag="{Binding}" Click="Open_Click"/>
       <Button Content="Mã QR" Style="{StaticResource ActionButton}" IsEnabled="{x:Bind CanUse, Mode=OneWay}" Tag="{Binding}" Click="Qr_Click"/>
      </StackPanel>
     </Grid>
    </Border>
   </DataTemplate>
   <Style x:Key="SidebarItem" TargetType="ToggleButton">
    <Setter Property="Height" Value="44"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="12,0"/><Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
     <Border x:Name="HoverBorder" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
      <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverBorder.Background" Value="{ThemeResource SidebarHoverBrush}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverBorder.Opacity" Value="0.7"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="HoverBorder.Opacity" Value="0.4"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
      <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"/>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <Grid x:Name="MediaLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" Visibility="Collapsed">
   <MediaPlayerElement x:Name="BackgroundVideo" AreTransportControlsEnabled="False" AutoPlay="False" Stretch="UniformToFill" Visibility="Collapsed"/>
   <Image x:Name="BackgroundGif" Stretch="UniformToFill" Visibility="Collapsed"/>
  </Grid>
  <Border Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="10,20,10,16" RowSpacing="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
     <Border Background="{ThemeResource SoftAccentBrush}" Width="32" Height="32" CornerRadius="8"><FontIcon Glyph="&#xE71B;" FontSize="17" Foreground="{ThemeResource BrandBrush}"/></Border>
     <TextBlock x:Name="BrandLabel" Text="QH Multi-Link" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource InkBrush}"/>
    </StackPanel>
    <Grid Grid.Row="1" VerticalAlignment="Top">
     <Border x:Name="NavigationIndicator" Height="44" Background="{ThemeResource SidebarSelectionBrush}" CornerRadius="8" VerticalAlignment="Top" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform x:Name="NavTranslation"/></Border.RenderTransform></Border>
     <StackPanel x:Name="NavigationButtons" Spacing="6">
      <ToggleButton x:Name="CreateNavButton" Style="{StaticResource SidebarItem}" Tag="create" IsChecked="True" Click="Navigate_Click" AutomationProperties.Name="Tạo liên kết" ToolTipService.ToolTip="Tạo liên kết"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE71B;" FontSize="16"/><TextBlock x:Name="CreateNavLabel" Text="Tạo liên kết" FontSize="14"/></StackPanel></ToggleButton>
      <ToggleButton x:Name="HistoryNavButton" Style="{StaticResource SidebarItem}" Tag="history" Click="Navigate_Click" AutomationProperties.Name="Lịch sử" ToolTipService.ToolTip="Lịch sử"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE81C;" FontSize="16"/><TextBlock x:Name="HistoryNavLabel" Text="Lịch sử" FontSize="14"/></StackPanel></ToggleButton>
      <ToggleButton x:Name="SettingsNavButton" Style="{StaticResource SidebarItem}" Tag="settings" Click="Navigate_Click" AutomationProperties.Name="Cài đặt" ToolTipService.ToolTip="Cài đặt"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock x:Name="SettingsNavLabel" Text="Cài đặt" FontSize="14"/></StackPanel></ToggleButton>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="12">
     <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" MinHeight="44" Padding="12,8" Click="QuickWindow_Click" IsEnabled="{x:Bind VM.QuickWindowEnabled, Mode=OneWay}" AutomationProperties.Name="Mở cửa sổ nổi" ToolTipService.ToolTip="Cửa sổ nổi · Bật/tắt trong Cài đặt"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8A7;" FontSize="16"/><TextBlock x:Name="QuickNavLabel" Text="Cửa sổ nổi" FontSize="13"/></StackPanel></Button>
     <Button Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Click="ToggleMotion_Click" Visibility="{x:Bind VM.BackgroundMediaVisibility, Mode=OneWay}" IsEnabled="{x:Bind VM.CanControlBackground, Mode=OneWay}" AutomationProperties.Name="{x:Bind VM.MotionButtonLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind VM.MotionTooltip, Mode=OneWay}"><FontIcon x:Name="MotionGlyph" Glyph="&#xE769;" FontSize="16"/></Button>
     <Grid ColumnSpacing="4" MinHeight="44"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ThemeLabel" Text="{x:Bind VM.ThemeToggleLabel, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
      <ToggleSwitch x:Name="ThemeSwitch" Grid.Column="1" IsOn="{x:Bind VM.DarkThemeEnabled, Mode=TwoWay}" Toggled="Theme_Toggled" OnContent="" OffContent="" MinWidth="40" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}" AutomationProperties.Name="Giao diện tối" ToolTipService.ToolTip="Chuyển sáng/tối · tự lưu"/>
     </Grid>
    </StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="MainContent" Grid.Column="1" Padding="24" RowSpacing="16" HorizontalAlignment="Stretch">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <InfoBar IsOpen="{x:Bind VM.HasNotice, Mode=TwoWay}" Message="{x:Bind VM.Notice, Mode=OneWay}" Severity="Informational" AutomationProperties.LiveSetting="Polite"/>
   <ScrollViewer x:Name="CreatePage" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" Padding="0,0,4,8">
     <TextBlock x:Name="PageHeading" Text="Tạo liên kết" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" AutomationProperties.HeadingLevel="Level1"/>
     <Grid x:Name="CreateCards" ColumnSpacing="14" RowSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition x:Name="ResultsColumn" Width="0"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top">
      <StackPanel Spacing="16">
       <TextBox x:Name="UrlInput" Header="Đường dẫn gốc" PlaceholderText="https://example.com/duong-dan-cua-ban" Text="{x:Bind VM.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" FontSize="16" AccessKey="U" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}" KeyDown="UrlInput_KeyDown" AutomationProperties.HelpText="Chấp nhận địa chỉ http:// hoặc https://. Nhấn Enter để tạo link." GotFocus="UrlInput_GotFocus" LostFocus="UrlInput_LostFocus">
        <ToolTipService.ToolTip><ToolTip x:Name="UrlTip" Placement="Bottom" Content="Chấp nhận http:// và https://. Ứng dụng không tự truy cập URL đích."/></ToolTipService.ToolTip>
       </TextBox>
       <TextBlock Text="{x:Bind VM.UrlError, Mode=OneWay}" Visibility="{x:Bind VM.UrlErrorVisibility, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ErrorBrush}" AutomationProperties.LiveSetting="Assertive"/>
       <StackPanel Spacing="12">
        <Border Background="{ThemeResource SoftAccentBrush}" CornerRadius="8" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTipService.ToolTip="Đổi dịch vụ mặc định trong Cài đặt. Khi bật mật khẩu, ứng dụng ưu tiên dịch vụ có hỗ trợ mật khẩu."><TextBlock Text="{x:Bind VM.PreferredProviderDisplay, Mode=OneWay}" Foreground="{ThemeResource BrandBrush}" FontSize="13" TextWrapping="Wrap"/></Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
         <ProgressRing IsActive="{x:Bind VM.IsBusy, Mode=OneWay}" Visibility="{x:Bind VM.BusyVisibility, Mode=OneWay}" Width="24" Height="24" AutomationProperties.Name="Đang tạo link"/>
         <Button Content="Hủy" Visibility="{x:Bind VM.BusyVisibility, Mode=OneWay}" Style="{StaticResource ActionButton}" IsEnabled="{x:Bind VM.IsBusy, Mode=OneWay}" Command="{x:Bind VM.CancelCommand}"/>
         <Button x:Name="CreateButton" Content="Tạo liên kết" Style="{StaticResource AccentButtonStyle}" MinHeight="48" Padding="20,10" IsEnabled="{x:Bind VM.CanStart, Mode=OneWay}" Click="Shorten_Click" AccessKey="S"/>
        </StackPanel>
       </StackPanel>
       <Expander x:Name="AdvancedOptions" Header="Tùy chọn nâng cao" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}">
        <StackPanel Spacing="16">
         <ToggleSwitch Header="Bảo vệ bằng mật khẩu" OnContent="Bật" OffContent="Tắt" IsOn="{x:Bind VM.RequirePassword, Mode=TwoWay}" ToolTipService.ToolTip="Dùng dịch vụ có hỗ trợ mật khẩu. Mật khẩu không được lưu trong lịch sử."/>
         <StackPanel Visibility="{x:Bind VM.PasswordVisibility, Mode=OneWay}" Spacing="8">
          <PasswordBox x:Name="LinkPassword" Header="Mật khẩu của link" PasswordChanged="LinkPassword_Changed" PasswordRevealMode="Peek" MinHeight="44" ToolTipService.ToolTip="Tối thiểu 8 ký tự, gồm chữ, số và ký tự đặc biệt."/>
          <TextBlock Text="{x:Bind VM.PasswordError, Mode=OneWay}" Visibility="{x:Bind VM.PasswordErrorVisibility, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ErrorBrush}" AutomationProperties.LiveSetting="Assertive"/>
         </StackPanel>
         <ToggleSwitch Header="Tạo qua nhiều dịch vụ" OnContent="Bật" OffContent="Dùng dịch vụ ưu tiên" IsOn="{x:Bind VM.UseMultipleProviders, Mode=TwoWay}"/>
         <ItemsControl ItemsSource="{x:Bind VM.Providers}" Visibility="{x:Bind VM.MultiProviderVisibility, Mode=OneWay}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ProviderChoice">
           <CheckBox Content="{x:Bind Display, Mode=OneWay}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsConfigured, Mode=OneWay}" MinHeight="44" Visibility="{x:Bind Visibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind Name}"/>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <TextBlock Text="{x:Bind VM.ProviderError, Mode=OneWay}" Visibility="{x:Bind VM.ProviderErrorVisibility, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ErrorBrush}"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </Border>
      <StackPanel x:Name="ResultsPane" Grid.Row="1" Spacing="12" VerticalAlignment="Top">
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource HeadingBlock}" Padding="0"><TextBlock Text="Kết quả" Style="{StaticResource SectionTitle}"/></Border>
      <Button Grid.Column="1" Content="Chép tất cả" Style="{StaticResource ActionButton}" Click="CopyAll_Click"/>
     </Grid>
     <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="8" Padding="12,8"><TextBlock Text="{x:Bind VM.ProgressText, Mode=OneWay}" Foreground="{ThemeResource InkBrush}" FontSize="13" AutomationProperties.LiveSetting="Polite"/></Border>
     <Border Style="{StaticResource Card}" Padding="20" MinHeight="150" Visibility="{x:Bind VM.EmptyVisibility, Mode=OneWay}"><TextBlock Text="Link ngắn của bạn sẽ xuất hiện tại đây." Style="{StaticResource SecondaryText}"/></Border>
     <ItemsControl ItemsSource="{x:Bind VM.Results}" ItemTemplate="{StaticResource ResultTemplate}"/>
      </StackPanel>
     </Grid>
    </StackPanel>
   </ScrollViewer>
   <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource HeadingBlock}"><TextBlock Text="Lịch sử liên kết" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource InkBrush}" AutomationProperties.HeadingLevel="Level1"/></Border>
     <Button Grid.Column="1" Content="Xóa lịch sử" Style="{StaticResource ActionButton}" Click="ClearHistory_Click" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="1">
     <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{x:Bind VM.HistoryEmptyVisibility, Mode=OneWay}"><TextBlock Text="Chưa có lịch sử liên kết." Style="{StaticResource SecondaryText}"/></Border>
     <ListView ItemsSource="{x:Bind VM.History}" ItemTemplate="{StaticResource ResultTemplate}" SelectionMode="None" Background="Transparent" HorizontalContentAlignment="Stretch" Padding="0,0,4,0">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
     </ListView>
    </Grid>
   </Grid>
   <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Padding="0,0,4,4">
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource HeadingBlock}"><TextBlock Text="Cài đặt" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource InkBrush}" AutomationProperties.HeadingLevel="Level1"/></Border>
      <Button Grid.Column="1" Content="Lưu cài đặt" Style="{StaticResource AccentButtonStyle}" Padding="20,10" MinHeight="44" Click="SaveSettings_Click" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}" VerticalAlignment="Center"/>
     </Grid>
     <Border Style="{StaticResource Card}" Padding="20"><StackPanel Spacing="16">
      <Border Style="{StaticResource HeadingBlock}"><TextBlock Text="Cửa sổ nổi" Style="{StaticResource SectionTitle}"/></Border>
      <ToggleSwitch Header="Bật cửa sổ nổi" IsOn="{x:Bind VM.QuickWindowEnabled, Mode=TwoWay}" Toggled="QuickWindow_Toggled" OnContent="Bật" OffContent="Tắt" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Áp dụng và lưu tự động. Khi tắt, tab ở mép phải cũng biến mất. Khi bật, tab xuất hiện lại."/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="20"><StackPanel Spacing="16">
      <Border Style="{StaticResource HeadingBlock}"><TextBlock Text="Dịch vụ ưu tiên" Style="{StaticResource SectionTitle}"/></Border>
      <ComboBox Header="Dịch vụ mặc định" ItemsSource="{x:Bind VM.Providers}" DisplayMemberPath="Display" SelectedIndex="{x:Bind VM.DefaultProviderIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Dùng ngay dịch vụ này khi tạo link. Dịch vụ cần key phải được kết nối trước. Khi cần mật khẩu, chọn dịch vụ tương thích.">
      </ComboBox>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="20"><StackPanel Spacing="16">
      <Border Style="{StaticResource HeadingBlock}"><TextBlock Text="Màu sắc và nền động" Style="{StaticResource SectionTitle}"/></Border>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border x:Name="ColorPreview" Width="44" Height="44" CornerRadius="10" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1"/>
       <TextBlock Grid.Column="1" Text="{x:Bind VM.BackgroundColor, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource InkBrush}"/>
       <Button Grid.Column="2" Content="Chọn màu nền" Style="{StaticResource ActionButton}" Click="ChooseColor_Click"/>
      </Grid>
      <TextBlock Text="{x:Bind VM.BackgroundLabel, Mode=OneWay}" Style="{StaticResource SecondaryText}"/>
      <TextBlock Text="GIF / MP4 · tối đa 15 giây · 20 MB · Full HD" Style="{StaticResource SecondaryText}"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
       <Button x:Name="ImportBackgroundButton" Content="Chọn GIF / MP4" Style="{StaticResource ActionButton}" Click="ImportBackground_Click"/>
       <Button Content="Bỏ nền động" Style="{StaticResource ActionButton}" Click="RemoveBackground_Click"/>
       <Button Content="{x:Bind VM.MotionButtonLabel, Mode=OneWay}" Style="{StaticResource ActionButton}" Click="ToggleMotion_Click" Visibility="{x:Bind VM.BackgroundMediaVisibility, Mode=OneWay}" IsEnabled="{x:Bind VM.CanControlBackground, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind VM.MotionTooltip, Mode=OneWay}"/>
      </StackPanel>
      <TextBlock x:Name="MotionStatus" Style="{StaticResource SecondaryText}" Visibility="Collapsed"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="20"><StackPanel Spacing="16">
      <Border Style="{StaticResource HeadingBlock}"><TextBlock Text="Kết nối dịch vụ" Style="{StaticResource SectionTitle}"/></Border>
      <ComboBox Header="Dịch vụ cần kết nối" ItemsSource="{x:Bind VM.Connections}" DisplayMemberPath="Name" SelectedIndex="{x:Bind VM.ConnectionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}"/>
      <TextBlock Text="{x:Bind VM.ApiKeyStatus, Mode=OneWay}" Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite"/>
      <PasswordBox x:Name="ApiKeyInput" Header="API key mới" Password="{x:Bind VM.ConnectionKey, Mode=TwoWay}" PlaceholderText="Để trống nếu giữ key đã lưu" PasswordRevealMode="Peek" MinHeight="44" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Phần nhập dở được giữ riêng khi chuyển dịch vụ. Bấm Lưu key dịch vụ này để lưu. Short.io dùng public API key."/>
      <TextBox Header="Domain Short.io" Text="{x:Bind VM.ConnectionDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ten.short.gy" Visibility="{x:Bind VM.DomainVisibility, Mode=OneWay}" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}" ToolTipService.ToolTip="Domain thuộc tài khoản Short.io của bạn, không kèm https:// hoặc đường dẫn. Có thể đổi domain và giữ key đã lưu."/>
      <TextBlock Text="{x:Bind VM.ConnectionError, Mode=OneWay}" Visibility="{x:Bind VM.ConnectionErrorVisibility, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ErrorBrush}" AutomationProperties.LiveSetting="Assertive"/>
      <Button Content="Lưu key dịch vụ này" Command="{x:Bind VM.SaveConnectionCommand}" Style="{StaticResource AccentButtonStyle}" MinHeight="44" Padding="16,10" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><HyperlinkButton Content="Tài liệu và API key" NavigateUri="{x:Bind VM.ConnectionDocumentation, Mode=OneWay}" MinHeight="44"/><Button Content="Xóa key đã lưu" Command="{x:Bind VM.RemoveApiKeyCommand}" Style="{StaticResource ActionButton}" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}"/></StackPanel>
     </StackPanel></Border>
     <Expander Header="Hiệu suất và riêng tư" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind VM.CanEdit, Mode=OneWay}"><StackPanel Spacing="16">
      <NumberBox Header="Số dịch vụ chạy đồng thời" Value="{x:Bind VM.Concurrency, Mode=TwoWay}" Minimum="1" Maximum="6" SmallChange="1" SpinButtonPlacementMode="Compact"/>
      <NumberBox Header="Thời gian chờ mỗi dịch vụ (giây)" Value="{x:Bind VM.TimeoutSeconds, Mode=TwoWay}" Minimum="5" Maximum="60" SmallChange="5" SpinButtonPlacementMode="Compact"/>
      <ToggleSwitch Header="Lưu URL gốc trong lịch sử" IsOn="{x:Bind VM.SaveOriginalUrl, Mode=TwoWay}" OnContent="Bật" OffContent="Tắt" ToolTipService.ToolTip="Chỉ áp dụng cho lần tạo tiếp theo. Mật khẩu không bao giờ được lưu. Xóa lịch sử để xóa dữ liệu cũ."/>
     </StackPanel></Expander>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
