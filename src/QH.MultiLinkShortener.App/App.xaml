<Application x:Class="QH.MultiLinkShortener.App.App" RequestedTheme="Light"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <Color x:Key="BrandColor">#2864DF</Color>
     <Color x:Key="OnBrandColor">#FFFFFF</Color>
     <SolidColorBrush x:Key="CanvasBrush" Color="#F5F7FB" />
     <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
     <SolidColorBrush x:Key="InkBrush" Color="#191D28" />
     <SolidColorBrush x:Key="MutedBrush" Color="#535A6B" />
     <SolidColorBrush x:Key="LineBrush" Color="#DFE2E9" />
     <SolidColorBrush x:Key="SoftAccentBrush" Color="#E3E9FD" />
     <SolidColorBrush x:Key="BrandBrush" Color="#2864DF" />
     <SolidColorBrush x:Key="OnBrandBrush" Color="#FFFFFF" />
     <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
     <Color x:Key="SystemAccentColor">#2864DF</Color>
     <Color x:Key="SystemAccentColorDark1">#2864DF</Color>
     <Color x:Key="SystemAccentColorDark2">#2257C4</Color>
     <Color x:Key="SystemAccentColorDark3">#1B489F</Color>
     <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2864DF" />
     <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2257C4" />
     <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1B489F" />
     <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#2864DF" />
     <SolidColorBrush x:Key="AccentButtonBackground" Color="#2864DF" />
     <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2257C4" />
     <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1B489F" />
     <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#2864DF" />
     <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#2864DF" />
     <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2864DF" />
     <SolidColorBrush x:Key="SidebarBrush" Color="#EFF0F4"/>
     <SolidColorBrush x:Key="SidebarSelectionBrush" Color="#E0E7FF"/>
     <SolidColorBrush x:Key="SidebarHoverBrush" Color="#10000000"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
     <Color x:Key="BrandColor">#9B8CE2</Color>
     <Color x:Key="OnBrandColor">#100D1B</Color>
     <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#100D1B"/>
     <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#100D1B"/>
     <SolidColorBrush x:Key="CanvasBrush" Color="#0C0E17" />
     <SolidColorBrush x:Key="SurfaceBrush" Color="#1D1F28" />
     <SolidColorBrush x:Key="InkBrush" Color="#F1F2F8" />
     <SolidColorBrush x:Key="MutedBrush" Color="#B5B6C2" />
     <SolidColorBrush x:Key="LineBrush" Color="#363944" />
     <SolidColorBrush x:Key="SoftAccentBrush" Color="#302A49" />
     <SolidColorBrush x:Key="BrandBrush" Color="#9B8CE2" />
     <SolidColorBrush x:Key="OnBrandBrush" Color="#100D1B" />
     <SolidColorBrush x:Key="ErrorBrush" Color="#FFA49C" />
     <Color x:Key="SystemAccentColor">#9B8CE2</Color>
     <Color x:Key="SystemAccentColorLight1">#9B8CE2</Color>
     <Color x:Key="SystemAccentColorLight2">#AE9CEB</Color>
     <Color x:Key="SystemAccentColorLight3">#C9BAF6</Color>
     <Color x:Key="SystemAccentColorDark1">#9B8CE2</Color>
     <Color x:Key="SystemAccentColorDark2">#A89AE8</Color>
     <Color x:Key="SystemAccentColorDark3">#B6A9F0</Color>
     <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#9B8CE2" />
     <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#A89AE8" />
     <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B6A9F0" />
     <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#9B8CE2" />
     <SolidColorBrush x:Key="AccentButtonBackground" Color="#9B8CE2" />
     <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#A89AE8" />
     <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#B6A9F0" />
     <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#9B8CE2" />
     <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#9B8CE2" />
     <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#9B8CE2" />
     <SolidColorBrush x:Key="SidebarBrush" Color="#05060B"/>
     <SolidColorBrush x:Key="SidebarSelectionBrush" Color="#453D67"/>
     <SolidColorBrush x:Key="SidebarHoverBrush" Color="#14FFFFFF"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
     <Color x:Key="BrandColor">#2864DF</Color>
     <Color x:Key="OnBrandColor">#FFFFFF</Color>
     <SolidColorBrush x:Key="CanvasBrush" Color="#F5F7FB" />
     <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
     <SolidColorBrush x:Key="InkBrush" Color="#191D28" />
     <SolidColorBrush x:Key="MutedBrush" Color="#535A6B" />
     <SolidColorBrush x:Key="LineBrush" Color="#DFE2E9" />
     <SolidColorBrush x:Key="SoftAccentBrush" Color="#E3E9FD" />
     <SolidColorBrush x:Key="BrandBrush" Color="#2864DF" />
     <SolidColorBrush x:Key="OnBrandBrush" Color="#FFFFFF" />
     <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
     <Color x:Key="SystemAccentColor">#2864DF</Color>
     <Color x:Key="SystemAccentColorDark1">#2864DF</Color>
     <Color x:Key="SystemAccentColorDark2">#2257C4</Color>
     <Color x:Key="SystemAccentColorDark3">#1B489F</Color>
     <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2864DF" />
     <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2257C4" />
     <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1B489F" />
     <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#2864DF" />
     <SolidColorBrush x:Key="AccentButtonBackground" Color="#2864DF" />
     <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2257C4" />
     <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1B489F" />
     <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#2864DF" />
     <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#2864DF" />
     <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2864DF" />
     <SolidColorBrush x:Key="SidebarBrush" Color="#EFF0F4"/>
     <SolidColorBrush x:Key="SidebarSelectionBrush" Color="#E0E7FF"/>
     <SolidColorBrush x:Key="SidebarHoverBrush" Color="#10000000"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <StaticResource x:Key="BrandColor" ResourceKey="SystemColorHighlightColor"/>
     <StaticResource x:Key="OnBrandColor" ResourceKey="SystemColorHighlightTextColor"/>
     <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
     <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
     <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="LineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="SoftAccentBrush" Color="{ThemeResource SystemColorWindowColor}" />
     <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
     <SolidColorBrush x:Key="OnBrandBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
     <SolidColorBrush x:Key="ErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="SidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="SidebarSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
     <SolidColorBrush x:Key="SidebarHoverBrush" Color="{ThemeResource SystemColorWindowColor}"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="24" />
   </Style>
   <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
   </Style>
   <Style x:Key="HeadingBlock" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0" />
   </Style>
   <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="14" />
   </Style>
   <Style x:Key="ActionButton" TargetType="Button">
    <Setter Property="MinHeight" Value="44" /><Setter Property="MinWidth" Value="44" />
    <Setter Property="Padding" Value="12,8" />
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
